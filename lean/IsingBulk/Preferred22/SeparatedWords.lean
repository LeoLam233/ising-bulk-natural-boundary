import IsingBulk.Preferred22.SeparatedFrame
import IsingBulk.Preferred22.FrameAlgebra
import IsingBulk.Preferred22.MarkedTransportRecursion

/-! An explicit finite expansion of genuine fixed-q frame words into
products of analytic factors and genuinely real angular factors. -/
namespace IsingBulk.Preferred22
noncomputable section
open Set Filter
open scoped BigOperators Topology ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false

/-- The analytic factor generated by the actual separated product rule. -/
def preferredSeparatedAnalytic {N : ℕ} (F : ℂ × (Fin N → ℂ) → ℂ) :
    (xs : List (Option (Fin N))) → PreferredMarkedWord N xs.length → ℂ × (Fin N → ℂ) → ℂ
  | [], _ => F
  | a::xs, w => match w 0 with
    | none => preferredComplexFrameJet (preferredSeparatedAnalytic F xs (Fin.tail w)) [a]
    | some ib => fun z => preferredSeparatedAnalytic F xs (Fin.tail w) z *
        preferredSeparatedInverseFactor a ib.2 z

/-- Every derivative of an angular factor is a real derivative. -/
def preferredSeparatedAngular {N : ℕ} (τ : ℝ) (p m : ℝ → ℝ)
    (G : (Fin N → ℝ) → ℂ) :
    (xs : List (Option (Fin N))) → PreferredMarkedWord N xs.length → (Fin N → ℝ) → ℂ
  | [], _ => G
  | _::xs, w => match w 0 with
    | none => preferredSeparatedAngular τ p m G xs (Fin.tail w)
    | some ib => fun θ => (preferredContourMatrix τ p m θ)⁻¹ ib.1 ib.2 *
        fderiv ℝ (preferredSeparatedAngular τ p m G xs (Fin.tail w)) θ (Pi.single ib.1 1)

theorem preferred_real_coordinate_deriv {N : ℕ} (G : (Fin N → ℝ) → ℂ)
    (θ : Fin N → ℝ) (hG : DifferentiableAt ℝ G θ) (i : Fin N) :
    deriv (fun x : ℝ => G (Function.update θ i x)) (θ i)=fderiv ℝ G θ (Pi.single i 1) := by
  exact (hG.hasFDerivAt.comp_hasDerivAt_of_eq (θ i) (hasDerivAt_update θ i (θ i))
    (by simp only [Function.update_eq_self])).deriv

theorem preferredSeparatedInverseFactor_analyticAt {N : ℕ}
    (a : Option (Fin N)) (b : Fin N) (z : ℂ × (Fin N → ℂ))
    (hU : ∀ i, AnalyticAt ℂ (fun y : ℂ × ℂ => preferredMovingInverse y.1 y.2) (z.1,z.2 i)) :
    AnalyticAt ℂ (preferredSeparatedInverseFactor a b) z := by
  have hq (i : Fin N) : AnalyticAt ℂ (fun y : ℂ × (Fin N → ℂ) => (y.1,y.2 i)) z :=
    analyticAt_fst.prod (((ContinuousLinearMap.proj i : (Fin N → ℂ) →L[ℂ] ℂ).comp
      (ContinuousLinearMap.snd ℂ ℂ (Fin N → ℂ))).analyticAt z)
  cases a with
  | none =>
    exact AnalyticAt.comp (f := fun y : ℂ × (Fin N → ℂ) => (y.1,y.2 b))
      (g := fun y : ℂ × ℂ => preferredSourceUDot y.1 y.2)
      (preferredSourceUDot_analyticAt_of_joint z.1 (z.2 b) (hU b)) (hq b)
  | some a =>
    change AnalyticAt ℂ (fun y : ℂ × (Fin N → ℂ) => if b=a then preferredSourceUQ y.1 (y.2 a) else 0) z
    by_cases hba : b=a
    · simp only [hba,ite_true]
      exact AnalyticAt.comp (f := fun y : ℂ × (Fin N → ℂ) => (y.1,y.2 a))
        (g := fun y : ℂ × ℂ => preferredSourceUQ y.1 y.2)
        (preferredSourceUQ_analyticAt_of_joint z.1 (z.2 a) (hU a)) (hq a)
    · simpa only [hba,ite_false] using
        (analyticAt_const : AnalyticAt ℂ (fun _ : ℂ × (Fin N → ℂ) => (0:ℂ)) z)

theorem preferredSeparatedAnalytic_analyticAt {N : ℕ}
    (F : ℂ × (Fin N → ℂ) → ℂ) (xs : List (Option (Fin N)))
    (w : PreferredMarkedWord N xs.length) (z : ℂ × (Fin N → ℂ))
    (hF : AnalyticAt ℂ F z)
    (hU : ∀ i, AnalyticAt ℂ (fun y : ℂ × ℂ => preferredMovingInverse y.1 y.2) (z.1,z.2 i)) :
    AnalyticAt ℂ (preferredSeparatedAnalytic F xs w) z := by
  induction xs with
  | nil => exact hF
  | cons a xs ih =>
    cases hw : w 0 with
    | none =>
      simp only [preferredSeparatedAnalytic,hw]
      exact preferredComplexFrameJet_analyticAt _ [a] z (ih (Fin.tail w))
    | some ib =>
      simp only [preferredSeparatedAnalytic,hw]
      exact (ih (Fin.tail w)).mul (preferredSeparatedInverseFactor_analyticAt a ib.2 z hU)

theorem preferredSeparatedAngular_contDiff {N : ℕ} (τ : ℝ) (p m : ℝ → ℝ)
    (hp : ContDiff ℝ ∞ p) (hm : ContDiff ℝ ∞ m)
    (hM : ∀ θ : Fin N → ℝ, (preferredContourMatrix τ p m θ).det≠0)
    (G : (Fin N → ℝ) → ℂ) (hG : ContDiff ℝ ∞ G)
    (xs : List (Option (Fin N))) (w : PreferredMarkedWord N xs.length) :
    ContDiff ℝ ∞ (preferredSeparatedAngular τ p m G xs w) := by
  induction xs with
  | nil => exact hG
  | cons a xs ih =>
    cases hw : w 0 with
    | none => simpa only [preferredSeparatedAngular,hw] using ih (Fin.tail w)
    | some ib =>
      simp only [preferredSeparatedAngular,hw]
      have hMi : ContDiff ℝ ∞ (fun θ : Fin N → ℝ => (preferredContourMatrix τ p m θ)⁻¹ ib.1 ib.2) := by
        apply contDiff_iff_contDiffAt.mpr
        intro θ
        exact contDiffAt_pi.mp (contDiffAt_pi.mp
          (preferredContourMatrix_inverse_contDiffAt τ p m hp hm θ (hM θ)) ib.1) ib.2
      exact hMi.mul (((ContinuousLinearMap.apply ℝ ℂ (Pi.single ib.1 1)).contDiff).comp
        ((ih (Fin.tail w)).fderiv_right (by simp)))

theorem preferredSeparatedTerm_mixed {N : ℕ} (τ δ : ℝ) (p m : ℝ → ℝ)
    (hp : ContDiff ℝ ∞ p) (hm : ContDiff ℝ ∞ m)
    (hM : ∀ θ : Fin N → ℝ, (preferredContourMatrix τ p m θ).det≠0)
    (Ω : Set (ℂ × (Fin N → ℝ)))
    (hpoint : ∀ z∈Ω, PreferredFramePoint τ δ p m z.1 z.2)
    (F : ℂ × (Fin N → ℂ) → ℂ) (G : (Fin N → ℝ) → ℂ)
    (hF : ∀ z∈Ω, AnalyticAt ℂ F (z.1,preferredSourceCoordinate τ p m z.1 z.2))
    (hG : ContDiff ℝ ∞ G) (xs : List (Option (Fin N)))
    (w : PreferredMarkedWord N xs.length) :
    PreferredMixedSmoothOn (fun z =>
      preferredSeparatedAnalytic F xs w (z.1,preferredSourceCoordinate τ p m z.1 z.2)*
        preferredSeparatedAngular τ p m G xs w z.2) Ω := by
  have hA := preferred_analytic_pullback_mixed τ δ p m hp hm Ω hpoint
    (preferredSeparatedAnalytic F xs w) (fun z hz =>
      preferredSeparatedAnalytic_analyticAt F xs w _ (hF z hz) (hpoint z hz).inverse_analytic)
  have hT := preferredSeparatedAngular_contDiff τ p m hp hm hM G hG xs w
  apply hA.mul
  intro z _
  exact ⟨hT.contDiffAt.comp z contDiffAt_snd,
    differentiableAt_const (𝕜:=ℂ) (x:=z.1) (preferredSeparatedAngular τ p m G xs w z.2)⟩

theorem preferredFrameStep_sum {N : ℕ} {ι : Type*} [Fintype ι]
    (τ : ℝ) (p m : ℝ → ℝ) (a : Option (Fin N))
    (F : ι → ℂ → (Fin N → ℝ) → ℂ) (s : ℂ) (θ : Fin N → ℝ)
    (hs : ∀ i, DifferentiableAt ℂ (fun t => F i t θ) s)
    (hθ : ∀ i k, DifferentiableAt ℝ (fun x => F i s (Function.update θ k x)) (θ k)) :
    preferredFrameStep τ p m a (fun t x => ∑ i, F i t x) s θ=
      ∑ i, preferredFrameStep τ p m a (F i) s θ := by
  classical
  cases a with
  | none =>
    simp only [preferredFrameStep,preferredParameterFrame]
    rw [deriv_fun_sum (fun i _ => hs i)]
    simp_rw [deriv_fun_sum (fun i _ => hθ i _)]
    rw [Finset.sum_add_distrib,Finset.sum_comm]
    simp only [Finset.mul_sum]
  | some a =>
    simp only [preferredFrameStep,preferredCoordinateFrame]
    simp_rw [deriv_fun_sum (fun i _ => hθ i _)]
    rw [Finset.sum_comm]
    simp only [Finset.mul_sum]

def preferredSeparatedSum {N : ℕ} (τ : ℝ) (p m : ℝ → ℝ)
    (F : ℂ × (Fin N → ℂ) → ℂ) (G : (Fin N → ℝ) → ℂ)
    (xs : List (Option (Fin N))) (s : ℂ) (θ : Fin N → ℝ) : ℂ :=
  ∑ w : PreferredMarkedWord N xs.length,
    preferredSeparatedAnalytic F xs w (s,preferredSourceCoordinate τ p m s θ)*
      preferredSeparatedAngular τ p m G xs w θ

/-- An exact finite source-defined separated expansion of every actual
frame word. The real angular factors include the entire occupancy inverse
and its real derivatives; no holomorphic continuation of them is used. -/
theorem preferredFrameJet_separated_expansion {N : ℕ} (τ δ : ℝ) (p m : ℝ → ℝ)
    (hp : ContDiff ℝ ∞ p) (hm : ContDiff ℝ ∞ m)
    (hM : ∀ θ : Fin N → ℝ, (preferredContourMatrix τ p m θ).det≠0)
    (Ω : Set (ℂ × (Fin N → ℝ))) (hΩ : IsOpen Ω)
    (hpoint : ∀ z∈Ω, PreferredFramePoint τ δ p m z.1 z.2)
    (F : ℂ × (Fin N → ℂ) → ℂ) (G : (Fin N → ℝ) → ℂ)
    (hF : ∀ z∈Ω, AnalyticAt ℂ F (z.1,preferredSourceCoordinate τ p m z.1 z.2))
    (hG : ContDiff ℝ ∞ G) (xs : List (Option (Fin N)))
    (s : ℂ) (θ : Fin N → ℝ) (hz : (s,θ)∈Ω) :
    preferredFrameJet τ p m (fun t x => F (t,preferredSourceCoordinate τ p m t x)*G x) xs s θ=
      preferredSeparatedSum τ p m F G xs s θ := by
  classical
  induction xs generalizing s θ with
  | nil => simp [preferredFrameJet,preferredSeparatedSum,preferredSeparatedAnalytic,preferredSeparatedAngular]
  | cons a xs ih =>
    have he (z : ℂ × (Fin N → ℝ)) (hz : z∈Ω) := ih z.1 z.2 hz
    have hcong : preferredFrameStep τ p m a
        (preferredFrameJet τ p m (fun t x => F (t,preferredSourceCoordinate τ p m t x)*G x) xs) s θ=
        preferredFrameStep τ p m a (preferredSeparatedSum τ p m F G xs) s θ := by
      cases a with
      | none => exact preferredParameterFrame_congr_open τ p m _ _ Ω hΩ he s θ hz
      | some a => exact preferredCoordinateFrame_congr_open τ p m a _ _ Ω hΩ he s θ hz
    rw [preferredFrameJet_cons,hcong]
    have hterm (w : PreferredMarkedWord N xs.length) :=
      preferredSeparatedTerm_mixed τ δ p m hp hm hM Ω hpoint F G hF hG xs w
    unfold preferredSeparatedSum
    rw [preferredFrameStep_sum τ p m a _ s θ (fun w => (hterm w (s,θ) hz).2)
      (fun w => preferredMixed_coordinate_differentiable _ s θ (hterm w (s,θ) hz).1)]
    have hstep (w : PreferredMarkedWord N xs.length) := preferredFrame_separated_step τ δ p m
      (hp.differentiable (by simp)) (hm.differentiable (by simp)) s θ (hpoint (s,θ) hz)
      (preferredSeparatedAnalytic F xs w) (preferredSeparatedAngular τ p m G xs w)
      (preferredSeparatedAnalytic_analyticAt F xs w _ (hF (s,θ) hz) (hpoint (s,θ) hz).inverse_analytic).differentiableAt
      ((preferredSeparatedAngular_contDiff τ p m hp hm hM G hG xs w).differentiable (by simp)).differentiableAt a
    have hstep' (w : PreferredMarkedWord N xs.length) :
        preferredFrameStep τ p m a (fun t x =>
          preferredSeparatedAnalytic F xs w (t,preferredSourceCoordinate τ p m t x)*
            preferredSeparatedAngular τ p m G xs w x) s θ=
        preferredComplexFrameJet (preferredSeparatedAnalytic F xs w) [a]
          (s,preferredSourceCoordinate τ p m s θ)*preferredSeparatedAngular τ p m G xs w θ+
        ∑ i, ∑ b,
          (preferredSeparatedAnalytic F xs w (s,preferredSourceCoordinate τ p m s θ)*
            preferredSeparatedInverseFactor a b (s,preferredSourceCoordinate τ p m s θ))*
          ((preferredContourMatrix τ p m θ)⁻¹ i b*
            fderiv ℝ (preferredSeparatedAngular τ p m G xs w) θ (Pi.single i 1)) := by
      have hh := hstep w
      simp_rw [preferred_real_coordinate_deriv _ θ
        (((preferredSeparatedAngular_contDiff τ p m hp hm hM G hG xs w).differentiable (by simp)).differentiableAt) ] at hh
      cases a <;> exact hh
    simp_rw [hstep']
    erw [← (Fin.consEquiv (fun _ : Fin (xs.length+1) => Option (Fin N × Fin N))).sum_comp]
    have hcons (b : Option (Fin N × Fin N)) (w : PreferredMarkedWord N xs.length) :
        (Fin.consEquiv (fun _ : Fin (xs.length+1) => Option (Fin N × Fin N))) (b,w)=Fin.cons b w := rfl
    rw [Fintype.sum_prod_type,Fintype.sum_option]
    simp only [hcons,preferredSeparatedAnalytic,preferredSeparatedAngular,Fin.cons_zero,Fin.tail_cons]
    rw [Finset.sum_add_distrib]
    congr 1
    conv_rhs => rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro w _
    rw [Fintype.sum_prod_type]

end
end IsingBulk.Preferred22
