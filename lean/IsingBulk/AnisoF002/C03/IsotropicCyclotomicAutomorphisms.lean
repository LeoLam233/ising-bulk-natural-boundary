import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.RingTheory.RootsOfUnity.Complex
import Mathlib.Data.ZMod.Units
import Mathlib.Data.Nat.ModEq
import Mathlib.Tactic.LinearCombination

/-!
# Cyclotomic automorphisms for F002's own prime arithmetic

All fields in this file are generated by actual complex roots of unity.
The automorphisms are constructed from the checked cyclotomic minimal
polynomial, rather than assumed as a physical or arithmetic premise.
-/

namespace IsingBulk.AnisoF002.Isotropic
noncomputable section
open Polynomial
open scoped IntermediateField

theorem isotropic_root_adjoin_cyclotomic {N : ℕ} (hN : 0 < N)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ N) :
    IsCyclotomicExtension {N} ℚ (IntermediateField.adjoin ℚ {ζ}) := by
  let : NeZero N := ⟨hN.ne'⟩
  have hi : IsIntegral ℚ ζ := (hζ.isIntegral hN).tower_top
  change IsCyclotomicExtension {N} ℚ
    (IntermediateField.adjoin ℚ {ζ}).toSubalgebra
  rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hi.isAlgebraic]
  exact hζ.adjoin_isCyclotomicExtension ℚ

theorem exists_isotropic_cyclotomic_power_automorphism {N k : ℕ}
    (hN : 0 < N) {ζ : ℂ} (hζ : IsPrimitiveRoot ζ N) (hk : k.Coprime N) :
    ∃ f : (IntermediateField.adjoin ℚ {ζ}) ≃ₐ[ℚ]
        (IntermediateField.adjoin ℚ {ζ}),
      ∀ x : IntermediateField.adjoin ℚ {ζ}, x ^ N = 1 → f x = x ^ k := by
  let : NeZero N := ⟨hN.ne'⟩
  let : NeZero (N : ℚ) := ⟨by exact_mod_cast hN.ne'⟩
  let K := IntermediateField.adjoin ℚ {ζ}
  let z : K := ⟨ζ, IntermediateField.mem_adjoin_simple_self ℚ ζ⟩
  have hz : IsPrimitiveRoot z N := by
    rwa [← IsPrimitiveRoot.coe_submonoidClass_iff]
  let : IsCyclotomicExtension {N} ℚ K := isotropic_root_adjoin_cyclotomic hN hζ
  have hzk := hz.pow_of_coprime k hk
  let f := (hz.powerBasis ℚ).equivOfMinpoly (hzk.powerBasis ℚ)
    ((hz.minpoly_eq_cyclotomic_of_irreducible (cyclotomic.irreducible_rat hN)).symm.trans
      (hzk.minpoly_eq_cyclotomic_of_irreducible (cyclotomic.irreducible_rat hN)))
  have hf : f z = z ^ k := by
    exact (hz.powerBasis ℚ).equivOfMinpoly_gen (hzk.powerBasis ℚ) _
  refine ⟨f, fun x hx => ?_⟩
  obtain ⟨j, _, rfl⟩ := hz.eq_pow_of_pow_eq_one hx
  rw [map_pow, hf, ← pow_mul, ← pow_mul, Nat.mul_comm]

theorem isotropic_root_mem_cyclotomic_adjoin {N : ℕ} (hN : 0 < N)
    {ζ x : ℂ} (hζ : IsPrimitiveRoot ζ N) (hx : x ^ N = 1) :
    x ∈ IntermediateField.adjoin ℚ {ζ} := by
  let : NeZero N := ⟨hN.ne'⟩
  obtain ⟨j, _, rfl⟩ := hζ.eq_pow_of_pow_eq_one hx
  exact (IntermediateField.adjoin ℚ {ζ}).pow_mem
    (IntermediateField.mem_adjoin_simple_self ℚ ζ) j

theorem isotropic_root_pow_eq_of_modEq {N a b : ℕ} {x : ℂ}
    (hx : x ^ N = 1) (hab : a ≡ b [MOD N]) : x ^ a = x ^ b := by
  rw [← pow_mod_orderOf x a, ← pow_mod_orderOf x b]
  congr 1
  exact hab.of_dvd (orderOf_dvd_of_pow_eq_one hx)

theorem isotropic_primitive_trace_ne_square_trace {p : ℕ} (hp : 5 ≤ p)
    {x : ℂ} (hx : IsPrimitiveRoot x p) :
    x + x⁻¹ ≠ x ^ 2 + (x ^ 2)⁻¹ := by
  have hxp : 0 < p := by omega
  have hx0 : x ≠ 0 := hx.ne_zero hxp.ne'
  intro he
  have hf : (x - 1) ^ 2 * (x ^ 2 + x + 1) = 0 := by
    field_simp at he
    linear_combination -he
  rcases mul_eq_zero.mp hf with h1 | h3
  · have hx1 : x = 1 := sub_eq_zero.mp (sq_eq_zero_iff.mp h1)
    have hdiv := (hx.pow_eq_one_iff_dvd 1).mp (by simp [hx1])
    exact (Nat.not_dvd_of_pos_of_lt (by omega : 0 < 1) (by omega : 1 < p)) hdiv
  · have hx3 : x ^ 3 = 1 := by
      linear_combination (x - 1) * h3
    have hdiv := (hx.pow_eq_one_iff_dvd 3).mp hx3
    exact (Nat.not_dvd_of_pos_of_lt (by omega : 0 < 3) (by omega : 3 < p)) hdiv

end
end IsingBulk.AnisoF002.Isotropic
